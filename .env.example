# OpenAI 설정 템플릿
# 실제 값은 .env 에 넣으세요 (.env 는 .gitignore 에 의해 커밋되지 않습니다).

# OpenAI API 키 (https://platform.openai.com → API keys)
OPENAI_API_KEY=sk-...

# 사용할 모델 (생략 시 코드 기본값 gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Mock 모드: 1이면 OpenAI 호출 없이 결정론적 mock 분석을 반환한다.
# 키 없이 /api/analyze 응답·UI를 끝까지 점검할 때만 사용 (요약에 mock 마커 표시). 평소엔 주석 유지.
# ANALYZE_MOCK=1
